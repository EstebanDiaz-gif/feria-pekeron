{
  "name": "Feria Pekerón",
  "short_name": "Feria",
  "description": "Comprá y vendé en tu zona. Publicar es gratis y sin comisiones.",
  "id": "./",
  "start_url": "./#inicio",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFF6E9",
